<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de Confirmación (destino del intent explícito 3, devuelve un resultado).
     "main" recibe el espacio de las barras del sistema; el margen va en el contenedor interno. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/padding_pantalla">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_seccion"
        android:layout_marginBottom="@dimen/espacio_seccion"
        android:gravity="center"
        android:text="@string/titulo_confirm"
        android:textColor="@color/azul_sede"
        android:textSize="@dimen/texto_titulo"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvResumen"
        style="@style/TextoTarjeta"
        android:layout_marginBottom="@dimen/espacio_seccion" />

    <!-- Rojo = cancelar (descarta) · Verde = confirmar (acción segura) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelar"
            style="@style/Boton.Rojo"
            android:layout_width="0dp"
            android:layout_marginEnd="@dimen/espacio_chico"
            android:layout_weight="1"
            android:text="@string/btn_cancelar" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmar"
            style="@style/Boton.Verde"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/espacio_chico"
            android:layout_weight="1"
            android:text="@string/btn_confirmar" />
    </LinearLayout>

</LinearLayout>
</FrameLayout>
